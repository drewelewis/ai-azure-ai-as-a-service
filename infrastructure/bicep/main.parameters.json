{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "secondaryLocation": {
      "value": "${AZURE_SECONDARY_LOCATION}"
    },
    "environment": {
      "value": "${AZURE_ENV_NAME}"
    },
    "companyPrefix": {
      "value": "${AZURE_COMPANY_PREFIX}"
    },
    "deployRbac": {
      "value": "${AZURE_DEPLOY_RBAC}"
    },
    "deployJumpbox": {
      "value": "${AZURE_DEPLOY_JUMPBOX}"
    },
    "deployLoadTest": {
      "value": "${AZURE_DEPLOY_LOAD_TEST}"
    },
    "deployingUserObjectId": {
      "value": "${AZURE_DEPLOYING_USER_OBJECT_ID}"
    },
    "sslCertKeyVaultSecretId": {
      "value": "${AZURE_SSL_CERT_KV_SECRET_ID}"
    },
    "generatedSslCertificatePfx": {
      "value": "${AZURE_SSL_CERT_PFX_BASE64}"
    }
  }
}
