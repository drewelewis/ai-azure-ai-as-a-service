// E2E Trace — Panel 2: Requests per Subscription over Time (clustered columns)
// Data source:  AppRequests
// Parameters:   {TimeRange}        — workbook time-range picker
//               {SubscriptionName} — LOB subscription filter (value:all = no filter)
//
// 5-minute buckets, each coloured column = one APIM subscription (LOB).
// Unstacked columns keep equal per-subscription request counts visible side by side.

AppRequests
| where TimeGenerated {TimeRange}
| extend sub = tostring(Properties["Subscription Name"])
| where isnotempty(sub)
| where "{SubscriptionName}" == "value:all" or sub == "{SubscriptionName}"
| summarize Requests = count() by bin(TimeGenerated, 5m), sub
| sort by TimeGenerated asc
